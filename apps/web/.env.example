# URL y clave pública del Supabase local. Copia estos valores de `pnpm db:start`
# (o `pnpm exec supabase status`) a un archivo `.env.local`, que no se sube al repositorio.
# En producción, apuntan a la instancia desplegada.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=tu-clave-publica-anon
