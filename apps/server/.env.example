# URL con el rol dueño; solo la usan las migraciones y las pruebas de esquema.
MIGRATION_DATABASE_URL=postgres://axia_owner:CHANGE_ME@127.0.0.1:5433/axia

# URL con el rol de la aplicación; sin permisos de DDL.
DATABASE_URL=postgres://axia_app:CHANGE_ME@127.0.0.1:5433/axia

# Contraseña que se asigna al rol axia_app al preparar la base local.
AXIA_APP_PASSWORD=CHANGE_ME
