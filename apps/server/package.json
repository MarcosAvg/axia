{
  "name": "@axia/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:db": "vitest run test/db",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "tsx scripts/reset-db.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
