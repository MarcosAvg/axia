# Axia — producción
# Usar la referencia exacta del paquete de release (tag de versión o digest).
AXIA_IMAGE=
# Genera cada valor con: openssl rand -hex 32
# Solo hexadecimal (URL-safe): /, #, ? o % rompen las URLs de conexión.
POSTGRES_OWNER_PASSWORD=
AXIA_APP_PASSWORD=

# El reverse proxy o túnel y su TLS se configuran fuera de este compose.
# La app se publica solo en la red Docker `proxy` como `axia:3100`.
# Crear/conectar la red del proxy antes de arrancar; AXIA_PROXY_NETWORK cambia su nombre.
# Ajustes avanzados: docs/reference/configuracion.md
