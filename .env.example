# Axia en producción

# Base de datos. Genera dos valores hexadecimales distintos con openssl rand -hex 32.
POSTGRES_OWNER_PASSWORD=
AXIA_APP_PASSWORD=

# Imagen. Para una instalación con datos, descomenta y usa el digest de release.json.
# Si omites AXIA_IMAGE, Compose usa el canal estable :latest.
# AXIA_IMAGE=ghcr.io/marcosavg/axia/axia-app:vX.Y.Z

# Proxy HTTPS. Descomenta solo si necesitas cambiar la red o el alias.
# AXIA_PROXY_NETWORK=proxy
# AXIA_PROXY_ALIAS=axia

# Web Push (opcional). Configura ambas variables siguiendo la guía de instalación.
# El contacto admite mailto: o una URL HTTPS.
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT=
