# PostgreSQL local / autoalojado. Ningún valor real vive en el repositorio.
POSTGRES_DB=axia
POSTGRES_OWNER_USER=axia_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME
AXIA_APP_USER=axia_app
AXIA_APP_PASSWORD=CHANGE_ME
DB_PORT=5433

# Ajuste conservador para una instalación pequeña. En un servidor dedicado,
# shared_buffers ≈ 25 % de la RAM y effective_cache_size ≈ 50–75 %.
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_MAX_CONNECTIONS=50

# Servidor HTTP. En desarrollo se publica solo en 127.0.0.1:APP_PORT.
APP_PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false
BODY_LIMIT_BYTES=1048576
HEALTH_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000
# STATIC_DIR=/app/web

# Sesiones y acceso local.
SESSION_COOKIE_NAME=axia_session
SESSION_ABSOLUTE_TTL_HOURS=168
SESSION_IDLE_TTL_HOURS=24
SESSION_TOUCH_INTERVAL_SECONDS=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_IP_ATTEMPTS=20
LOGIN_WINDOW_MINUTES=15
PASSWORD_MIN_LENGTH=12

# Usadas por scripts y pruebas fuera de Docker.
MIGRATION_DATABASE_URL=postgres://axia_owner:CHANGE_ME@127.0.0.1:5433/axia
DATABASE_URL=postgres://axia_app:CHANGE_ME@127.0.0.1:5433/axia

# Evidencias y archivos.
STORAGE_DIR=/data/evidence
EVIDENCE_MAX_BYTES=20971520
EVIDENCE_MAX_DIMENSION=4096
EVIDENCE_THUMBNAIL_SIZE=320
EVIDENCE_QUOTA_BYTES=524288000
SSE_HEARTBEAT_MS=15000
SYNC_FUTURE_TOLERANCE_MS=300000
SYNC_MAX_AGE_MS=2592000000

# Cliente web en el corte final; vacío usa el mismo origen.
VITE_API_URL=
