# Axia — producción
# Genera cada valor con: openssl rand -hex 32
POSTGRES_OWNER_PASSWORD=
AXIA_APP_PASSWORD=

# Hay un reverse proxy TLS delante de app.
TRUST_PROXY=true

# Puerto de loopback que publica compose.yaml para el proxy.
APP_PORT=3100

# Imagen publicada en GHCR. Para producción reproducible, fija un SHA.
AXIA_VERSION=latest

# Opcional: nivel de registro (info por defecto).
# LOG_LEVEL=info
#
# El resto de valores usa los defaults de compose.yaml y del servidor.
# Ajustes avanzados: docs/reference/configuracion.md
