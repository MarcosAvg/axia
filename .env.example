# PostgreSQL local / autoalojado. Ningún valor real vive en el repositorio.
POSTGRES_DB=axia
POSTGRES_OWNER_USER=axia_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME
AXIA_APP_USER=axia_app
AXIA_APP_PASSWORD=CHANGE_ME
DB_PORT=5433

# Ajuste conservador para una instalación pequeña. En un servidor dedicado,
# shared_buffers ≈ 25 % de la RAM y effective_cache_size ≈ 50–75 %.
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_MAX_CONNECTIONS=50

# Usadas por scripts y pruebas fuera de Docker.
MIGRATION_DATABASE_URL=postgres://axia_owner:CHANGE_ME@127.0.0.1:5433/axia
DATABASE_URL=postgres://axia_app:CHANGE_ME@127.0.0.1:5433/axia
