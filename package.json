{
  "name": "axia",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "pnpm --filter @axia/web dev",
    "build": "pnpm --filter @axia/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "check:agnostic": "node scripts/check-agnostic.mjs",
    "check:boundaries": "depcruise apps/web/src --config .dependency-cruiser.cjs",
    "check": "pnpm lint && pnpm typecheck && pnpm check:agnostic && pnpm check:boundaries && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "dependency-cruiser": "^18.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  }
}
