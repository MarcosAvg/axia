{
  "name": "axia",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @axia/server build && pnpm --filter @axia/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:visual": "pnpm --filter @axia/web test:visual",
    "test:scripts": "bash scripts/install.test.sh && bash scripts/dev-api.test.sh && bash deploy/scripts/recovery.test.sh && bash deploy/scripts/compose-image.test.sh && node --test scripts/*.test.mjs",
    "format": "prettier --write .",
    "check:agnostic": "node scripts/check-agnostic.mjs",
    "check:boundaries": "depcruise apps/web/src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "check": "pnpm lint && pnpm typecheck && pnpm check:static && pnpm test && pnpm db:test && pnpm build",
    "db:start": "docker compose --env-file \"${AXIA_ENV_FILE:-.env.dev}\" -f compose.dev.yaml up -d --wait db",
    "db:stop": "docker compose --env-file \"${AXIA_ENV_FILE:-.env.dev}\" -f compose.dev.yaml stop db",
    "db:reset": "pnpm --filter @axia/server db:reset",
    "db:test": "pnpm --filter @axia/server test:db",
    "db:demo": "pnpm --filter @axia/server db:demo",
    "db:indexes": "pnpm --filter @axia/server db:indexes",
    "db:cleanup": "pnpm --filter @axia/server db:cleanup",
    "db:cleanup-evidence": "pnpm --filter @axia/server db:cleanup-evidence",
    "db:duplicates": "pnpm --filter @axia/server db:duplicates",
    "prepare": "husky",
    "check:docs": "node scripts/check-docs.mjs",
    "dev:api": "bash scripts/dev-api.sh",
    "test:unit": "pnpm --filter @axia/server test:unit && pnpm --filter @axia/web test:unit",
    "test:affected": "node scripts/test-affected.mjs",
    "test:e2e": "pnpm --filter @axia/web exec playwright test",
    "test:e2e:smoke": "pnpm --filter @axia/web exec playwright test --grep @smoke",
    "check:fast": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "check:static": "pnpm test:scripts && pnpm check:docs && pnpm check:agnostic && pnpm check:boundaries && pnpm knip",
    "test:db:start": "docker compose --env-file /dev/null -f compose.test.yaml up -d --wait db",
    "test:db:stop": "docker compose --env-file /dev/null -f compose.test.yaml down"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "dependency-cruiser": "^18.5.0",
    "husky": "^9.1.7",
    "knip": "^6.40.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  }
}
