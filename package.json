{
  "name": "axia",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "pnpm --filter @axia/web dev",
    "build": "pnpm --filter @axia/server build && pnpm --filter @axia/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:visual": "pnpm --filter @axia/web test:visual",
    "test:scripts": "bash scripts/install.test.sh",
    "format": "prettier --write .",
    "check:agnostic": "node scripts/check-agnostic.mjs",
    "check:boundaries": "depcruise apps/web/src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "check": "pnpm lint && pnpm typecheck && pnpm test:scripts && pnpm check:docs && pnpm check:agnostic && pnpm check:boundaries && pnpm knip && pnpm test && pnpm db:test && pnpm build",
    "db:start": "docker compose -f compose.yaml -f compose.dev.yaml up -d db",
    "db:stop": "docker compose stop db",
    "db:reset": "pnpm --filter @axia/server db:reset",
    "db:test": "pnpm --filter @axia/server test:db",
    "db:next:up": "docker compose -f compose.yaml -f compose.dev.yaml up -d db",
    "db:next:migrate": "pnpm --filter @axia/server db:migrate",
    "db:next:reset": "pnpm --filter @axia/server db:reset",
    "db:next:test": "pnpm --filter @axia/server test:db",
    "db:next:check": "pnpm --filter @axia/server db:check",
    "db:next:indexes": "pnpm --filter @axia/server db:indexes",
    "db:next:demo": "pnpm --filter @axia/server db:demo",
    "check:next": "pnpm --filter @axia/server lint && pnpm --filter @axia/server typecheck && pnpm --filter @axia/server test && pnpm --filter @axia/server build && pnpm --filter @axia/server db:check && pnpm --filter @axia/server test:db",
    "prepare": "husky",
    "check:docs": "node scripts/check-docs.mjs",
    "dev:api": "bash scripts/dev-api.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "dependency-cruiser": "^18.5.0",
    "husky": "^9.1.7",
    "knip": "^6.40.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  }
}
