{
  "name": "axia",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "pnpm --filter @axia/web dev",
    "build": "pnpm --filter @axia/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm db:clean",
    "test:visual": "pnpm --filter @axia/web test:visual",
    "format": "prettier --write .",
    "check:agnostic": "node scripts/check-agnostic.mjs",
    "check:boundaries": "depcruise apps/web/src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "check": "pnpm lint && pnpm typecheck && pnpm check:agnostic && pnpm check:boundaries && pnpm knip && pnpm test && pnpm db:test && pnpm build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:clean": "node scripts/clean-test-data.mjs",
    "db:types": "supabase gen types typescript --local | prettier --stdin-filepath packages/shared/src/database.types.ts > packages/shared/src/database.types.ts",
    "env:local": "node scripts/write-local-env.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "dependency-cruiser": "^18.5.0",
    "husky": "^9.1.7",
    "knip": "^6.40.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "supabase": "^2.120.0",
    "typescript": "~6.0.3"
  }
}
