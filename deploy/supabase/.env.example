# Variables clave del compose oficial de Supabase, como recordatorio. No son valores reales.
# Copiar el `.env.example` del compose oficial a `deploy/supabase/docker/.env` y reemplazar cada valor.
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE
JWT_SECRET=CAMBIA_ESTE_SECRETO
ANON_KEY=CAMBIA_ESTA_CLAVE_ANON
SERVICE_ROLE_KEY=CAMBIA_ESTA_CLAVE_SERVICE_ROLE
DASHBOARD_USERNAME=CAMBIA_USUARIO
DASHBOARD_PASSWORD=CAMBIA_CLAVE
SITE_URL=https://TU_DOMINIO_WEB
API_EXTERNAL_URL=https://TU_DOMINIO_API
SUPABASE_PUBLIC_URL=https://TU_DOMINIO_API
# SMTP (opcional, para correos de Auth y notificaciones)
SMTP_ADMIN_EMAIL=TU_CORREO
SMTP_HOST=TU_SMTP
SMTP_PORT=587
SMTP_USER=TU_USUARIO_SMTP
SMTP_PASS=TU_CLAVE_SMTP
