# Configuración del despliegue de Axia con Docker Compose.
# Copia este archivo a `.env` y edítalo. NO subas `.env` al repositorio.

# Supabase destino (Cloud o autoalojado): URL y clave pública (anon).
SUPABASE_URL=https://tu-supabase.ejemplo
SUPABASE_ANON_KEY=tu_clave_anon

# Conexión para las migraciones (percent-encoded si tiene caracteres especiales).
# En Supabase Cloud, TLS va por defecto. En autoalojado sin TLS añade `?sslmode=disable`.
DATABASE_URL=postgresql://postgres:clave@tu-supabase.ejemplo:5432/postgres

# Puerto donde publica el contenedor web (tu reverse proxy TLS apunta aquí).
WEB_PORT=8080

# Imágenes publicadas. Déjalas comentadas para construir en local (`docker compose build`).
# AXIA_WEB_IMAGE=ghcr.io/tu-usuario/axia-web:latest
# AXIA_MIGRATE_IMAGE=ghcr.io/tu-usuario/axia-migrate:latest
