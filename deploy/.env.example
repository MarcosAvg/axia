# Configuración del despliegue de Axia con Docker Compose.
# Crear el archivo `.env` a partir de esta plantilla y ajustar los valores.
# El archivo `.env` no debe incorporarse al repositorio.

# Backend Supabase (Cloud o autoalojado): URL y clave pública (anon).
SUPABASE_URL=https://tu-supabase.ejemplo
SUPABASE_ANON_KEY=tu_clave_anon

# Conexión para las migraciones (percent-encoded si contiene caracteres especiales).
# Supabase Cloud usa TLS por defecto; en autoalojado sin TLS debe añadirse `?sslmode=disable`.
DATABASE_URL=postgresql://postgres:clave@tu-supabase.ejemplo:5432/postgres

# Puerto donde publica el contenedor web. El reverse proxy TLS apunta a ese puerto.
WEB_PORT=8080

# Imágenes publicadas. Si se dejan comentadas, las imágenes se construyen en local
# con `docker compose build`.
# AXIA_WEB_IMAGE=ghcr.io/tu-usuario/axia-web:latest
# AXIA_MIGRATE_IMAGE=ghcr.io/tu-usuario/axia-migrate:latest
